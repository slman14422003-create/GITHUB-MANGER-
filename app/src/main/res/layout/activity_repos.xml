<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnAccount"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:contentDescription="@string/acc_title"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/repos"
                android:textColor="?attr/cTextPrimary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/cTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnStatus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_icon_btn"
            android:clickable="true"
            android:contentDescription="@string/gs_title"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_status"
                android:tint="?attr/cTextPrimary" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/us_open"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnCleanup"
            style="@style/IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/rs_cleanup"
            android:src="@drawable/ic_trash_sweep" />

        <ImageButton
            android:id="@+id/btnNew"
            style="@style/IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/new_repo"
            android:src="@drawable/ic_add" />

        <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />

        <!-- iOS-style activity indicator: shown over the refresh button while the screen loads -->
        <com.ghmanager.app.IosSpinner
            android:id="@+id/refreshSpinner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:visibility="invisible" />
    </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tokenWarn"
        style="@style/StatusBanner"
        android:drawablePadding="10dp"
        android:minHeight="48dp"
        android:textColor="?attr/cTextPrimary"
        android:textIsSelectable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/paneMine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="?attr/cTextHint"
        android:hint="@string/search_repos"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:textColor="?attr/cTextPrimary"
        android:textColorHint="?attr/cTextHint"
        android:textSize="15sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/status"
        style="@style/StatusBanner"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/paneStore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="14dp">

            <EditText
                android:id="@+id/storeSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:drawableTint="?attr/cTextHint"
                android:hint="@string/store_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="52dp"
                android:paddingBottom="14dp"
                android:textColor="?attr/cTextPrimary"
                android:textColorHint="?attr/cTextHint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/storeClear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/store_clear_search"
                android:gravity="center"
                android:text="✕"
                android:textColor="?attr/cTextSecondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/storeRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="2dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/storeChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/storeStatus"
            style="@style/StatusBanner"
            android:visibility="gone" />

        <TextView
            android:id="@+id/storeRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/rs_retry"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/storeHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/storeSwipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ListView
                    android:id="@+id/storeList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <ImageView
                android:id="@+id/storeTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:clickable="true"
                android:contentDescription="@string/store_top"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_up"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/storeMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="?attr/cTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
