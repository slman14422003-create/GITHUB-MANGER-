<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="colorPrimary">?attr/cAccent</item>
        <item name="colorPrimaryDark">?attr/cBg</item>
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">?attr/cBg</item>
        <item name="android:statusBarColor">?attr/cBg</item>
        <item name="android:navigationBarColor">?attr/cBg</item>
        <item name="android:windowLightStatusBar">?attr/cLightBars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">?attr/cLightBars</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:textColorHint">?attr/cTextHint</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="colorControlNormal">?attr/cTextSecondary</item>
        <item name="colorControlActivated">?attr/cAccentText</item>
        <item name="android:textColorLink">?attr/cAccentText</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnim</item>
        <item name="cBg">@color/bg</item>
        <item name="cSurface">@color/surface</item>
        <item name="cSurfaceHigh">@color/surface_high</item>
        <item name="cField">@color/field</item>
        <item name="cStroke">@color/stroke</item>
        <item name="cStrokeSoft">@color/stroke_soft</item>
        <item name="cTextPrimary">@color/text_primary</item>
        <item name="cTextSecondary">@color/text_secondary</item>
        <item name="cTextHint">@color/text_hint</item>
        <item name="cAccent">@color/accent</item>
        <item name="cAccentText">@color/accent_text</item>
        <item name="cAccentSoft">@color/accent_soft</item>
        <item name="cNeutralSoft">@color/neutral_soft</item>
        <item name="cOnAccent">@color/on_accent</item>
        <item name="cRipple">@color/ripple</item>
        <item name="cRippleOnAccent">@color/ripple_on_accent</item>
        <item name="cOk">@color/ok</item>
        <item name="cBad">@color/bad</item>
        <item name="cWarn">@color/warn</item>
        <item name="cInfo">@color/info</item>
        <item name="cBtnStart">#FFFFFF</item>
        <item name="cBtnEnd">#DDE5FF</item>
        <item name="cLightBars">@bool/light_bars</item>
    </style>

    <style name="Overlay.Light" parent="ThemeOverlay.AppCompat.Light">
        <item name="cBg">@color/light_bg</item>
        <item name="cSurface">@color/light_surface</item>
        <item name="cSurfaceHigh">@color/light_surface_high</item>
        <item name="cField">@color/light_field</item>
        <item name="cStroke">@color/light_stroke</item>
        <item name="cStrokeSoft">@color/light_stroke_soft</item>
        <item name="cTextPrimary">@color/light_text_primary</item>
        <item name="cTextSecondary">@color/light_text_secondary</item>
        <item name="cTextHint">@color/light_text_hint</item>
        <item name="cAccent">@color/light_accent</item>
        <item name="cAccentText">@color/light_accent_text</item>
        <item name="cAccentSoft">@color/light_accent_soft</item>
        <item name="cNeutralSoft">@color/light_neutral_soft</item>
        <item name="cOnAccent">@color/light_on_accent</item>
        <item name="cRipple">@color/light_ripple</item>
        <item name="cRippleOnAccent">@color/light_ripple_on_accent</item>
        <item name="cOk">@color/light_ok</item>
        <item name="cBad">@color/light_bad</item>
        <item name="cWarn">@color/light_warn</item>
        <item name="cInfo">@color/light_info</item>
        <item name="cBtnStart">#3C6BF0</item>
        <item name="cBtnEnd">#2F5FE8</item>
        <item name="cLightBars">true</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:textColorHint">?attr/cTextHint</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="colorControlNormal">?attr/cTextSecondary</item>
        <item name="colorControlActivated">?attr/cAccentText</item>
        <item name="android:textColorLink">?attr/cAccentText</item>
        <item name="colorAccent">?attr/cAccentText</item>
    </style>

    <style name="Overlay.Amoled" parent="ThemeOverlay.AppCompat.Dark">
        <item name="cBg">@color/amoled_bg</item>
        <item name="cSurface">@color/amoled_surface</item>
        <item name="cSurfaceHigh">@color/amoled_surface_high</item>
        <item name="cField">@color/amoled_field</item>
        <item name="cStroke">@color/amoled_stroke</item>
        <item name="cStrokeSoft">@color/amoled_stroke_soft</item>
        <item name="cTextPrimary">@color/text_primary</item>
        <item name="cTextSecondary">@color/text_secondary</item>
        <item name="cTextHint">@color/amoled_text_hint</item>
        <item name="cAccent">@color/accent</item>
        <item name="cAccentText">@color/accent_text</item>
        <item name="cAccentSoft">@color/amoled_accent_soft</item>
        <item name="cNeutralSoft">@color/amoled_neutral_soft</item>
        <item name="cOnAccent">@color/on_accent</item>
        <item name="cRipple">@color/ripple</item>
        <item name="cRippleOnAccent">@color/ripple_on_accent</item>
        <item name="cOk">@color/ok</item>
        <item name="cBad">@color/bad</item>
        <item name="cWarn">@color/warn</item>
        <item name="cInfo">@color/info</item>
        <item name="cBtnStart">#FFFFFF</item>
        <item name="cBtnEnd">#DDE5FF</item>
        <item name="cLightBars">false</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:textColorHint">?attr/cTextHint</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="colorControlNormal">?attr/cTextSecondary</item>
        <item name="colorControlActivated">?attr/cAccentText</item>
        <item name="android:textColorLink">?attr/cAccentText</item>
        <item name="colorAccent">?attr/cAccentText</item>
    </style>

    <style name="ActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/DialogAnim</item>
        <item name="windowMinWidthMinor">92%</item>
        <item name="windowMinWidthMajor">60%</item>
        <item name="android:windowElevation">0dp</item>
    </style>

    <style name="DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dlg_in</item>
        <item name="android:windowExitAnimation">@anim/dlg_out</item>
    </style>

    <style name="SheetAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">?attr/cTextPrimary</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- one look for every inline status / error message -->
    <style name="StatusBanner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/bg_note</item>
        <item name="android:padding">14dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">?attr/cTextSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="BtnPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">?attr/cOnAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="BtnSecondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">?attr/cTextPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/anim_mark</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
