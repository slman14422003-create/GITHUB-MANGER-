<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- قارئ PDF: الأصوات العصبية (Edge TTS) وتحميل نموذج OCR وترجمة الصفحات تحتاج إنترنت،
         والمؤثرات الصوتية (Equalizer / LoudnessEnhancer) تحتاج MODIFY_AUDIO_SETTINGS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+: مطلوب حتى يرى التطبيق محركات النطق (TextToSpeech) المثبّتة للقراءة الصوتية -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".DocReaderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocReader">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DocumentViewerActivity"
            android:exported="false"
            android:label="@string/viewer_title" />

        <activity
            android:name=".DocEditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="@string/viewer_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- قارئ PDF المتقدّم (القراءة الصوتية بالتشكيل، البحث، الترجمة، OCR...). يُفتح أيضًا
             كخيار "فتح باستخدام" لأي ملف PDF من تطبيقات أخرى -->
        <activity
            android:name=".pdf.PdfViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:label="قارئ PDF"
            android:theme="@style/Theme.DocReader.PdfReader">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- مشاركة/فتح نسخة الملف في القارئ بتطبيق خارجي -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pdfshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pdf_share_paths" />
        </provider>

    </application>
</manifest>
